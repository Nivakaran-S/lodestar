// =============================================================================
// Waypoint Lodestar — Prisma Schema
// "Every order, one thread."  Team Adagard · Tech-Triathlon 2026
//
// Reference tables are loaded at seed time from DATA_DIR (see prisma/DATA.md).
// No dataset values live in this repository.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

// One PostgreSQL schema per owning service (PLATFORM.md §1). Cross-schema
// foreign keys keep referential integrity inside the one database; the agent's
// checkpoints live in the separate "agent" schema, which Prisma does not manage.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "orders", "planning", "fleet", "outlets", "trips", "sync", "notifications", "audit"]
}

// ─────────────────────────────────────────────────────────────
// Enumerations
// ─────────────────────────────────────────────────────────────

enum Role {
  DISPATCHER
  LOADER
  DRIVER
  STORE_MANAGER
  ADMIN

  @@schema("auth")
}

enum Brand {
  FRESH
  STYLE
  TECH

  @@schema("outlets")
}

enum TempClass {
  CHILLED
  AMBIENT

  @@schema("orders")
}

enum DockType {
  REAR_DOCK
  STREET
  MALL_BAY

  @@schema("outlets")
}

enum ParkingType {
  NORMAL
  VAN_ONLY
  MALL_DOCK

  @@schema("outlets")
}

enum VehicleType {
  TRUCK
  VAN

  @@schema("fleet")
}

enum VehicleStatus {
  AVAILABLE
  WORKSHOP
  ENROUTE

  @@schema("fleet")
}

enum OrderStatus {
  RECEIVED
  PLANNED
  LOADED
  ENROUTE
  DELIVERED
  DEFERRED
  EXCEPTION
  CANCELLED

  @@schema("orders")
}

enum TripStatus {
  PLANNED
  LOADING
  ENROUTE
  COMPLETE

  @@schema("trips")
}

enum NotificationChannel {
  PUSH
  SMS
  WEBSOCKET

  @@schema("notifications")
}

enum DeferralStatus {
  SUGGESTED
  CONFIRMED
  DISMISSED
  REVERSED

  @@schema("planning")
}

enum PlanStatus {
  DRAFT
  NEEDS_APPROVAL
  APPROVED
  PUBLISHED
  REJECTED
  SUPERSEDED

  @@schema("planning")
}

enum PlanSource {
  MANUAL
  AUTOPLAN
  AGENT

  @@schema("planning")
}

enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED

  @@schema("auth")
}

enum DeferralReason {
  CAP_REEFER
  CAP_TIME
  ACCESS
  WINDOW
  FUEL
  VEH_DOWN

  @@schema("planning")
}

// ─────────────────────────────────────────────────────────────
// Core entities
// ─────────────────────────────────────────────────────────────

/// Directory mirror of identity (Keycloak) users. `id` is the Keycloak subject (`sub`).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String? // legacy; credentials live in Keycloak
  role         Role
  depot        String? // Depot.code
  outletId     String?
  outlet       Outlet?  @relation(fields: [outletId], references: [id])
  vehicleId    String? // driver's vehicle (fleet.Vehicle id); mirrored to the vehicle_id token claim
  staffId      String?  @unique // loader's Dock sign-in ID (KDY-0427, LD-06); mirrored to the staff_id user attribute
  phone        String?
  refreshToken String?
  isActive     Boolean  @default(true)
  /// The signed-in user's own settings (DSP-20, DSP-33, SM-30): alert rules, notification channels, language,
  /// receiving staff. Read and written only through Me-scoped operations (MyPreferences, SaveMyPreferences).
  preferences  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  driverTrips   Trip[]         @relation("DriverTrips")
  loadRecords   LoadRecord[]
  notifications Notification[]
  offlineEvents OfflineEvent[]
  devices       Device[]

  @@schema("auth")
}

/// A depot (distribution centre), registered from the Admin desk (ADM-21). Every other `depot` column holds its
/// code; Outlet and DistrictTravel reference it by foreign key, other schemas by value (checked on write).
model Depot {
  code      String   @id // PELIYAGODA, KANDY: upper-case letters, digits and _
  name      String // "Peliyagoda DC"
  address   String?
  district  String
  lat       Float?
  lng       Float?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  outlets         Outlet[]
  districtTravels DistrictTravel[]

  @@schema("outlets")
}

model Outlet {
  id          String      @id // OUT001..OUT120
  name        String
  brand       Brand
  district    String
  depot       String // Depot.code
  depotRef    Depot       @relation(fields: [depot], references: [code])
  dockType    DockType
  parking     ParkingType
  windowOpen  String // "05:30" HH:mm
  windowClose String // "08:00" HH:mm
  mallWindow  String? // mall_dock outlets: the mall's delivery window "HH:mm-HH:mm" (outlet master mall_window)
  address     String?
  accessNote  String? // e.g. "Rear dock · enter via Lawson St service lane"
  lat         Float?
  lng         Float?
  isActive    Boolean     @default(true)
  updatedAt   DateTime    @default(now()) @updatedAt

  // Relations
  users     User[]
  orders    Order[]
  tripStops TripStop[]

  @@schema("outlets")
}

model Vehicle {
  id            String        @id // VEH001..VEH060
  depot         String // Depot.code (outlets schema)
  type          VehicleType
  tempClass     TempClass
  capacityKg    Float
  capacityM3    Float
  kmPerLitre    Float
  weeklyLFuel   Int // weekly fuel quota in litres
  usedLThisWeek Int           @default(0)
  fuelWeekStart DateTime      @default(now()) // week usedLThisWeek counts (Monday 00:00 Colombo); an older week reads as 0 L
  status        VehicleStatus @default(AVAILABLE)
  workshopNote  String?
  updatedAt     DateTime      @default(now()) @updatedAt

  // Relations
  trips       Trip[]
  loadRecords LoadRecord[]

  @@schema("fleet")
}

model Order {
  id                String      @id // ORD0104216 format
  outletId          String
  outlet            Outlet      @relation(fields: [outletId], references: [id])
  runDate           DateTime // Scheduled delivery date (Tue 7 Apr 2026)
  orderedAt         DateTime // When placed (Mon 6 Apr 2:38 PM)
  brand             Brand
  tempClass         TempClass
  units             Int
  kg                Float
  m3                Float
  status            OrderStatus @default(RECEIVED)
  deferredYesterday Boolean     @default(false)
  daysSince         Int         @default(0)
  deferralScore     Int?
  notes             String?
  latePhone         Boolean     @default(false) // logged by dispatch after the 4:00 PM cut-off (DSP-10)
  lateReason        String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Store receipt (SM-03, Orders('…')/Lodestar.ConfirmReceipt): the store's own count
  unitsReceived  Int?
  unitsExpected  Int? // what the store expected to count (the order's units, as shown on the phone)
  receiptNote    String?
  receiptSavedAt DateTime? // counted on the phone (may be hours before it synced)
  receivedAt     DateTime? // recorded by the orders service
  receivedBy     String? // store manager (token subject)
  creditNoteId   String?   @unique // CN-YYMM-NNNN when the count is short; same id as the POD's credit note

  // Relations
  tripStop    TripStop?
  deferralLog DeferralLog?
  lineItems   OrderLineItem[]

  @@index([outletId, runDate])
  @@index([runDate])
  @@schema("orders")
}

model OrderLineItem {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id])
  name      String // "Samba rice 5 kg"
  qty       Int
  kg        Float
  tempClass TempClass
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([orderId])
  @@schema("orders")
}

model Trip {
  id            String     @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle    @relation(fields: [vehicleId], references: [id])
  driverId      String?
  driver        User?      @relation("DriverTrips", fields: [driverId], references: [id])
  depot         String // Depot.code (outlets schema)
  runDate       DateTime
  brand         Brand
  district      String
  status        TripStatus @default(PLANNED)
  planVersion   Int        @default(1) // increments on each re-plan
  tripNumber    Int        @default(1) // Trip 1, Trip 2 for same vehicle
  departTime    DateTime?
  returnTime    DateTime?
  planMinutes   Int?
  actualMinutes Int?
  sealNumber    String?
  reeferTempC   Float?
  bay           String? // loading bay code e.g. "K2", "P5"
  planId        String?
  plan          Plan?      @relation(fields: [planId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  stops         TripStop[]
  loadRecord    LoadRecord?
  notifications Notification[]
  offlineEvents OfflineEvent[]

  @@index([depot, runDate])
  @@index([planId])
  @@schema("trips")
}

model TripStop {
  id                  String      @id @default(cuid())
  tripId              String
  trip                Trip        @relation(fields: [tripId], references: [id])
  orderId             String      @unique
  order               Order       @relation(fields: [orderId], references: [id])
  outletId            String
  outlet              Outlet      @relation(fields: [outletId], references: [id])
  stopSeq             Int // 1, 2, 3…
  etaPlan             DateTime? // free-flow plan ETA (shown on plan board)
  etaModel            DateTime? // ML model ETA (shown to driver/store/live ops)
  etaModelBandEarly   DateTime?
  etaModelBandLate    DateTime?
  lateRiskPct         Int? // 0–100
  serviceMinPredicted Int? // ML predicted service duration
  arrivalActual       DateTime?
  leaveActual         DateTime?
  status              OrderStatus @default(PLANNED)
  updatedAt           DateTime    @default(now()) @updatedAt

  // POD
  pod       POD?
  podPhotos PodPhoto[]

  @@index([tripId, stopSeq])
  @@schema("trips")
}

model POD {
  id             String     @id @default(cuid())
  tripStopId     String     @unique
  tripStop       TripStop   @relation(fields: [tripStopId], references: [id])
  unitsDelivered Int
  unitsOrdered   Int
  photoUrl       String?
  receiverName   String?
  signature      String? // base64 SVG or URL
  exceptions     Json? // [{type, description, photoUrl}]
  creditNoteId   String? // e.g., CN-2604-0441
  savedOffline   Boolean    @default(false)
  savedAt        DateTime   @default(now())
  syncedAt       DateTime?
  createdAt      DateTime   @default(now())
  /// Photos of the drop stored for this stop (PodPhoto); photoUrl is the newest one's /media/pod-photos/<id>.
  photoCount     Int        @default(0)
  photos         PodPhoto[]
  /// The receiver's signature (a PodPhoto of kind SIGNATURE): /media/pod-photos/<id>, signed by receiverName at signedAt.
  signatureUrl   String?
  signedAt       DateTime?

  @@schema("trips")
}

/// A proof-of-delivery photo (DR-20/DR-03), stored in Postgres. Uploaded by the driver of the trip
/// (POST /media/pod-photos or a PHOTO sync event); read by the depot's dispatchers and the stop's store manager.
/// Unique per stop by SHA-256 and per client event id, so a replayed upload never stores a second copy.
model PodPhoto {
  id         String    @id @default(cuid())
  tripStopId String
  tripStop   TripStop  @relation(fields: [tripStopId], references: [id])
  /// Set once the stop's POD exists (a photo may reach the server before its POD).
  podId      String?
  pod        POD?      @relation(fields: [podId], references: [id], onDelete: SetNull)
  /// PHOTO (the drop) | SIGNATURE (the receiver's, a sanitised SVG)
  kind       String    @default("PHOTO")
  mime       String // image/jpeg | image/png | image/webp (checked against the magic bytes); image/svg+xml for a SIGNATURE
  bytes      Bytes
  size       Int
  sha256     String
  /// The client's outbox id (Idempotency-Key / PHOTO event id).
  eventId    String?   @unique
  takenAt    DateTime?
  uploadedBy String // token subject
  createdAt  DateTime  @default(now())

  @@unique([tripStopId, sha256])
  @@index([podId])
  @@schema("trips")
}

model LoadRecord {
  id          String    @id @default(cuid())
  tripId      String    @unique
  trip        Trip      @relation(fields: [tripId], references: [id])
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id])
  loaderId    String
  loader      User      @relation(fields: [loaderId], references: [id])
  bay         String
  sealNumber  String?
  reeferTempC Float?
  loadedAt    DateTime?
  releasedAt  DateTime?
  shortfalls  Json? // [{item, qtyOrdered, qtyLoaded, reason}]
  notes       String?
  updatedAt   DateTime  @default(now()) @updatedAt

  @@schema("trips")
}

// ─────────────────────────────────────────────────────────────
// Offline / sync
// ─────────────────────────────────────────────────────────────

model OfflineEvent {
  id               String    @id @default(cuid())
  driverId         String
  driver           User      @relation(fields: [driverId], references: [id])
  tripId           String?
  trip             Trip?     @relation(fields: [tripId], references: [id])
  eventType        String // ARRIVAL | LEAVE | POD_SAVE | PHOTO | STATUS_CHANGE
  payload          Json
  savedAt          DateTime // when it was saved on device
  syncedAt         DateTime?
  conflictResolved Boolean   @default(false)
  conflictNote     String? // "field evidence wins; correction to OUT108"

  @@schema("sync")
}

// ─────────────────────────────────────────────────────────────
// Planning support
// ─────────────────────────────────────────────────────────────

model DeferralLog {
  id              String         @id @default(cuid())
  orderId         String         @unique
  order           Order          @relation(fields: [orderId], references: [id])
  reason          DeferralReason
  score           Int
  resolvedBy      String? // dispatcher user id
  notes           String?
  rescheduledDate DateTime?
  isProvisional   Boolean        @default(false) // set during blackout
  status          DeferralStatus @default(CONFIRMED)
  confirmedAt     DateTime?
  planId          String?
  plan            Plan?          @relation(fields: [planId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt

  @@schema("planning")
}

// ─────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────

model Notification {
  id          String              @id @default(cuid())
  recipientId String
  recipient   User                @relation(fields: [recipientId], references: [id])
  tripId      String?
  trip        Trip?               @relation(fields: [tripId], references: [id])
  type        String
  // DEFERRAL_SUGGESTED | BLACKOUT_DETECTED | SIGNAL_BACK | POD_MATCHED |
  // SHORTFALL_ACK | REEFER_FAIL | CREDIT_NOTE_ISSUED
  channel     NotificationChannel
  payload     Json
  sentAt      DateTime            @default(now())
  readAt      DateTime?
  updatedAt   DateTime            @default(now()) @updatedAt

  @@schema("notifications")
}

// ─────────────────────────────────────────────────────────────
// Reference / lookup tables (from CSVs)
// ─────────────────────────────────────────────────────────────

model Calendar {
  date         DateTime @id
  isOperating  Boolean
  isPayday     Boolean  @default(false)
  festivalRamp Float    @default(0)
  monsoon      Int      @default(0) // 0 or 1
  festivalName String?
  note         String?
  updatedAt    DateTime @default(now()) @updatedAt

  @@schema("outlets")
}

model DistrictTravel {
  district       String   @id
  depot          String // Depot.code
  depotRef       Depot    @relation(fields: [depot], references: [code])
  roadClass      String // urban | suburban | highway | hill
  depotToDistMin Int
  interStopMin   Int
  distKm         Float?
  updatedAt      DateTime @default(now()) @updatedAt

  @@schema("outlets")
}

/// One reference-data CSV import (ADM-14/15): the check result and what was applied. The CSV itself is never
/// stored; only counts, the checks and the rejected rows' reasons.
model DataImport {
  id         String   @id @default(cuid())
  file       String // outlets | vehicles | calendar | district_travel | service_allowance
  fileName   String? // the name of the uploaded file, for the screen
  rows       Int // data rows checked (header excluded)
  passed     Int // rows that passed every check
  applied    Boolean // true when the whole file was clean and written
  created    Int      @default(0)
  updated    Int      @default(0)
  problems   Json // [{row, key, column, value, reason}]
  checks     Json // [{label, passed, detail}]
  importedBy String // token subject
  byName     String?
  importedAt DateTime @default(now())

  @@index([file, importedAt])
  @@schema("outlets")
}

model ServiceAllowance {
  brand     Brand
  dockType  DockType
  minutes   Int
  updatedAt DateTime @default(now()) @updatedAt

  @@id([brand, dockType])
  @@schema("outlets")
}

// ─────────────────────────────────────────────────────────────
// Plans (planning service) and agent runs
// ─────────────────────────────────────────────────────────────

/// A versioned dispatch plan for one depot and run date, e.g. PLG-2026-04-07-v3.
/// Drafts come from people, the auto-planner or the planning agent;
/// only a human dispatcher can approve (publish) one.
model Plan {
  id          String     @id // PLG-2026-04-07-v3
  depot       String // Depot.code (outlets schema)
  runDate     DateTime
  version     Int
  status      PlanStatus @default(DRAFT)
  source      PlanSource @default(MANUAL)
  summary     Json? // capacity picture, counts, rule checks
  explanation String? // "What it did / what it checked" (DSP-02)
  agentRunId  String?
  createdBy   String? // subject of the creator (user or service client)
  approvedBy  String?
  approvedAt  DateTime?
  publishedAt DateTime?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  trips     Trip[]
  deferrals DeferralLog[]

  @@unique([depot, runDate, version])
  @@schema("planning")
}

/// Reference row for a planning-agent run. The run itself lives in the agent
/// service (LangGraph checkpoints); this row makes runs listable and scoped.
model AgentRun {
  id           String    @id // run id issued by the agent service
  depot        String // Depot.code (outlets schema)
  runDate      DateTime
  status       String // RUNNING | NEEDS_APPROVAL | APPROVED | REJECTED | FAILED ...
  requestedBy  String
  planId       String?
  decision     String? // approve | edit | reject
  decidedBy    String?
  detail       Json? // last snapshot returned by the agent
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([depot, runDate])
  @@schema("planning")
}

/// A weekly demand forecast as the capacity outlook (DSP-05) served it, kept so measureModels can score it
/// against the volume delivered once the week is over (WAPE). One row per depot, week and source; a later
/// forecast made before the week starts replaces the earlier one.
model DemandForecast {
  id         String   @id @default(cuid())
  depot      String // Depot.code (outlets schema)
  weekStart  DateTime // Monday of the ISO week, UTC midnight of the Colombo date
  source     String // model (ML service, Task 2A) | history-median (heuristic)
  totalM3    Float
  chilledM3  Float
  forecastAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([depot, weekStart, source])
  @@index([weekStart])
  @@schema("planning")
}

// ─────────────────────────────────────────────────────────────
// Devices (auth service): field-app device posture
// ─────────────────────────────────────────────────────────────

model Device {
  id           String       @id // device_id claim, e.g. DEV-RB-01
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  label        String?
  platform     String? // android | ios | web
  model        String?
  status       DeviceStatus @default(PENDING)
  /// A shared demo phone (the four seeded persona phones only, set by the seed; never through the API).
  /// Its owner may adopt it as the install id of any browser after sign-in (PLATFORM.md §2.6).
  sharedDemo   Boolean      @default(false)
  registeredAt DateTime     @default(now())
  lastSeenAt   DateTime?
  revokedAt    DateTime?
  revokedBy    String?
  revokeReason String?
  updatedAt    DateTime     @default(now()) @updatedAt

  @@index([userId])
  @@schema("auth")
}

// ─────────────────────────────────────────────────────────────
// Idempotency-Key records (libs/odata/src/idempotency.ts), one table in the
// schema of each service whose writes honour the header. Internal: @odata.ignore
// keeps them out of the EDM, so they are never served over OData.
// ─────────────────────────────────────────────────────────────

/// @odata.ignore Idempotency-Key records of the orders service (POST Orders, ConfirmReceipt).
model OrdersIdempotencyKey {
  userId      String // token subject: keys are per caller
  key         String // Idempotency-Key header
  route       String // METHOD + resource path
  requestHash String // sha256 of the canonical JSON body
  status      String   @default("PENDING") // PENDING | DONE
  response    Json? // {status, headers, body, audit} replayed to retries
  createdAt   DateTime @default(now())
  expiresAt   DateTime // createdAt + IDEMPOTENCY_TTL_HOURS (≥ 24 h)

  @@id([userId, key])
  @@index([expiresAt])
  @@map("IdempotencyKey")
  @@schema("orders")
}

/// @odata.ignore Dispatcher "close orders" for a run date and depot (Orders/Lodestar.CloseOrders, ReopenOrders):
/// while closed, no new order is taken for that run. Read through Orders/Lodestar.OrderWindow.
model OrderClosure {
  depot      String // Depot.code
  runDate    DateTime
  closed     Boolean   @default(true)
  closedBy   String
  closedAt   DateTime  @default(now())
  reason     String?
  reopenedBy String?
  reopenedAt DateTime?
  updatedAt  DateTime  @default(now()) @updatedAt

  @@id([depot, runDate])
  @@schema("orders")
}

/// @odata.ignore Idempotency-Key records of the trips service (Release, RecordShortfalls, POST LoadRecords).
model TripsIdempotencyKey {
  userId      String
  key         String
  route       String
  requestHash String
  status      String   @default("PENDING")
  response    Json?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@id([userId, key])
  @@index([expiresAt])
  @@map("IdempotencyKey")
  @@schema("trips")
}

// ─────────────────────────────────────────────────────────────
// Audit (audit service): append-only, hash chained
// ─────────────────────────────────────────────────────────────

/// One audit entry. hash = sha256(prevHash + canonicalJson(entry fields)).
/// UPDATE and DELETE are rejected by a database trigger.
model AuditEntry {
  seq        Int      @id @default(autoincrement())
  at         DateTime
  actor      String // token subject
  actorRoles String[]
  client     String // azp: the calling client (lodestar-web, svc-planning, ...)
  service    String // the service that performed the write
  action     String // e.g. Plans.Approve, Orders.Create
  entitySet  String?
  entityKey  String?
  outcome    String   @default("SUCCESS")
  payload    Json?
  prevHash   String
  hash       String   @unique

  @@index([entitySet, entityKey])
  @@index([at])
  @@schema("audit")
}
